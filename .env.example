APP_NAME='Netreverb'
APP_ENV=local
APP_KEY=
APP_DEBUG=false
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=netreverb_backend
DB_USERNAME=netreverb
DB_PASSWORD=

KAMAILIO_DB_HOST=127.0.0.1
KAMAILIO_DB_PORT=3307
KAMAILIO_DB_DATABASE=kamailio
KAMAILIO_DB_USERNAME=netreverb_provisioner
KAMAILIO_DB_PASSWORD=
KAMAILIO_DB_SOCKET=
KAMAILIO_DB_SSL_CA=
KAMAILIO_SIP_REALM=sip.classyra.com.ng
AUTOMATIC_EXTENSION_START=100000
AUTOMATIC_EXTENSION_END=899999
# FRONTEND_URL=http://localhost:5174,http://172.20.10.3:5174
FRONTEND_URL=http://172.20.10.3:5174
OAUTH_ENABLED_PROVIDERS=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

# Payment checkout remains off until provider test keys and webhook URLs are configured.
PAYMENTS_ENABLED=false
PAYMENTS_DEFAULT_GATEWAY=paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
API_DOCS_ENABLED=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Use true for HTTPS deployments. Keep only trusted frontend origins here.
SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.classyra.com.ng
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="mail@classyra.com.ng"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD=
FREESWITCH_RECORDINGS_DIR=storage/app/freeswitch/recordings/conferences


FREESWITCH_EVENT_SOCKET_HOST=127.0.0.1
FREESWITCH_EVENT_SOCKET_PORT=8021
FREESWITCH_CALL_RECORDINGS_BASE_PATH=/usr/local/freeswitch/var/lib/freeswitch/recordings/calls
FREESWITCH_RECORDINGS_BASE_PATH=/usr/local/freeswitch/var/lib/freeswitch/recordings/conferences

TURN_SECRET=
TURN_HOST=sip.classyra.com.ng
TURN_PORT=3478
TURNS_PORT=5349
TURN_CREDENTIAL_TTL=600
KAMAILIO_WSS_URL=wss://sip.classyra.com.ng:7443
SIP_REGISTRATION_EXPIRES=300

# LiveKit is used only for browser conference rooms. Keep the API secret server-side.
LIVEKIT_ENABLED=false
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=wss://livekit.classyra.com.ng
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_EGRESS_API_URL=http://127.0.0.1:7880
LIVEKIT_RECORDING_BUCKET=netreverb-recordings
LIVEKIT_RECORDING_S3_ENDPOINT=http://127.0.0.1:9000
LIVEKIT_RECORDING_S3_REGION=us-east-1
LIVEKIT_RECORDING_S3_ACCESS_KEY=
LIVEKIT_RECORDING_S3_SECRET=
LIVEKIT_TOKEN_TTL=300



FREESWITCH_CALL_RECORDINGS_AUTO_SYNC=true
FREESWITCH_CALL_RECORDINGS_SYNC_HOST=sip.classyra.com.ng
FREESWITCH_CALL_RECORDINGS_SYNC_USER=deploy
FREESWITCH_CALL_RECORDINGS_SYNC_PASSWORD=
FREESWITCH_CALL_RECORDINGS_SYNC_REMOTE_BASE=/usr/local/freeswitch/var/lib/freeswitch/recordings/calls


 FREESWITCH_CALL_RECORDING_ANNOUNCEMENT_DEFAULT_AUDIO_PATH=/usr/local/freeswitch/sounds/custom/recording_notice.wav
FREESWITCH_CALL_RECORDING_ANNOUNCEMENT_ALLOWED_AUDIO_PATHS=/usr/local/freeswitch/sounds/custom/recording_notice.wav

FREESWITCH_XML_CURL_TOKEN=
FREESWITCH_XML_CURL_ALLOWED_IPS=127.0.0.1,::1
FREESWITCH_XML_CURL_LOCAL_TEST_EXTENSIONS=
FREESWITCH_XML_CURL_LOCAL_TUNNEL_URL=

# Piper IVR voices. Configure each selected voice on every environment.
IVR_TTS_DRIVER=piper
PIPER_BINARY=/opt/piper/venv/bin/piper
PIPER_MODEL=/opt/piper/voices/en_US-lessac-medium.onnx
PIPER_VOICE_AMY_MODEL=/opt/piper/voices/en_US-amy-medium.onnx
PIPER_VOICE_RYAN_MODEL=/opt/piper/voices/en_US-ryan-medium.onnx
PIPER_VOICE_ALAN_MODEL=/opt/piper/voices/en_GB-alan-medium.onnx
PIPER_LENGTH_SCALE=1.05
PIPER_OUTPUT_DISK=public

# Outbound messages remain disabled until a production provider adapter,
# sender identity and signed delivery webhook are configured.
OUTBOUND_MESSAGING_ENABLED=false
OUTBOUND_MESSAGING_PROVIDER=disabled
OUTBOUND_MESSAGING_WEBHOOK_SECRET=
OUTBOUND_MESSAGING_TIMEZONE=Africa/Lagos
OUTBOUND_MESSAGING_RATE_LIMIT=30
OUTBOUND_MESSAGING_QUIET_START=20:00
OUTBOUND_MESSAGING_QUIET_END=08:00
EBULKSMS_ENDPOINT=https://api.ebulksms.com/sendsms.json
EBULKSMS_USERNAME=
EBULKSMS_KEY=
EBULKSMS_SENDER=
EBULKSMS_DND_SENDER=false
EBULKSMS_TIMEOUT=20
SMS_COST_PER_UNIT_MINOR=200
SMS_SELLING_PER_UNIT_MINOR=500
SMS_MINIMUM_PURCHASE_MINOR=500000

# Message translation depends on a reachable LibreTranslate instance.
MESSAGE_TRANSLATION_PROVIDER=libretranslate
MESSAGE_TRANSLATION_DEFAULT_TARGET_LOCALE=en
LIBRETRANSLATE_URL=http://127.0.0.1:5000
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_CONNECT_TIMEOUT=5
LIBRETRANSLATE_TIMEOUT=20



