APP_NAME=NetReverb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5174
API_DOCS_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=netreverb_backend
DB_USERNAME=netreverb
DB_PASSWORD=

KAMAILIO_DB_HOST=127.0.0.1
KAMAILIO_DB_PORT=3306
KAMAILIO_DB_DATABASE=kamailio
KAMAILIO_DB_USERNAME=netreverb_provisioner
KAMAILIO_DB_PASSWORD=
KAMAILIO_DB_SOCKET=
KAMAILIO_DB_SSL_CA=
KAMAILIO_SIP_REALM=sip.classyra.com.ng
KAMAILIO_SIP_SERVER=sip.classyra.com.ng
KAMAILIO_SIP_PORT=5060
KAMAILIO_WS_URL=ws://sip.classyra.com.ng:8080
KAMAILIO_WSS_URL=wss://sip.classyra.com.ng:7443
SIP_REGISTRATION_EXPIRES=300
AUTOMATIC_EXTENSION_START=100000
AUTOMATIC_EXTENSION_END=899999
TURN_SECRET=
TURN_HOST=sip.classyra.com.ng
TURN_PORT=3478
TURNS_PORT=5349
TURN_CREDENTIAL_TTL=600
FALLBACK_STUN_URL=stun:stun.l.google.com:19302

FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD=ClueCon
FREESWITCH_RECORDINGS_DIR=storage/app/freeswitch/recordings/conferences
FREESWITCH_RECORDINGS_DISK=freeswitch_recordings
FREESWITCH_CALL_RECORDINGS_DIR=storage/app/freeswitch/recordings/calls
FREESWITCH_CALL_RECORDINGS_DISK=freeswitch_call_recordings

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
