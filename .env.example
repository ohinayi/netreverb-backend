APP_NAME='Netreverb'
APP_ENV=local
APP_KEY=
APP_DEBUG=false
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=netreverb_backend
DB_USERNAME=netreverb
DB_PASSWORD=

KAMAILIO_DB_HOST=127.0.0.1
KAMAILIO_DB_PORT=3307
KAMAILIO_DB_DATABASE=kamailio
KAMAILIO_DB_USERNAME=netreverb_provisioner
KAMAILIO_DB_PASSWORD=
KAMAILIO_DB_SOCKET=
KAMAILIO_DB_SSL_CA=
KAMAILIO_SIP_REALM=sip.classyra.com.ng
AUTOMATIC_EXTENSION_START=100000
AUTOMATIC_EXTENSION_END=899999
# FRONTEND_URL=http://localhost:5174,http://172.20.10.3:5174
FRONTEND_URL=http://172.20.10.3:5174
API_DOCS_ENABLED=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Use true for HTTPS deployments. Keep only trusted frontend origins here.
SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.classyra.com.ng
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="mail@classyra.com.ng"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD=
FREESWITCH_RECORDINGS_DIR=storage/app/freeswitch/recordings/conferences


FREESWITCH_EVENT_SOCKET_HOST=127.0.0.1
FREESWITCH_EVENT_SOCKET_PORT=8021
FREESWITCH_CALL_RECORDINGS_BASE_PATH=/usr/local/freeswitch/var/lib/freeswitch/recordings/calls
FREESWITCH_RECORDINGS_BASE_PATH=/usr/local/freeswitch/var/lib/freeswitch/recordings/conferences

TURN_SECRET=
TURN_HOST=sip.classyra.com.ng
TURN_PORT=3478
TURNS_PORT=5349
TURN_CREDENTIAL_TTL=600
KAMAILIO_WSS_URL=wss://sip.classyra.com.ng:7443
SIP_REGISTRATION_EXPIRES=300



FREESWITCH_CALL_RECORDINGS_AUTO_SYNC=true
FREESWITCH_CALL_RECORDINGS_SYNC_HOST=sip.classyra.com.ng
FREESWITCH_CALL_RECORDINGS_SYNC_USER=deploy
FREESWITCH_CALL_RECORDINGS_SYNC_PASSWORD=
FREESWITCH_CALL_RECORDINGS_SYNC_REMOTE_BASE=/usr/local/freeswitch/var/lib/freeswitch/recordings/calls


 FREESWITCH_CALL_RECORDING_ANNOUNCEMENT_DEFAULT_AUDIO_PATH=/usr/local/freeswitch/sounds/custom/recording_notice.wav
FREESWITCH_CALL_RECORDING_ANNOUNCEMENT_ALLOWED_AUDIO_PATHS=/usr/local/freeswitch/sounds/custom/recording_notice.wav

FREESWITCH_XML_CURL_TOKEN=
FREESWITCH_XML_CURL_ALLOWED_IPS=127.0.0.1,::1
